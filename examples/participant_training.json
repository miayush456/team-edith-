    "reward": "UI-managed weights over all nine published signals",
    "compatibility_wrapper": "examples/participant_train.py"
  },
  "environment_contract": {
    "observation_size": "10 + selected ray count + lookahead count",
    "ray_count_limit": 16,
    "ray_angle_range_deg": [-90, 90],
    "ray_requires_center_zero": true,
    "action_size": 2,
    "raw_signal_source": "racing_event.VectorizedRacingEnv.step_raw"
  }
