{
  "release_id": "synapse-local-participant-prototype",
  "tracks": "tracks/train",
  "simulation_config": "config/simulation.json",
  "reference_trainer": "tools/run_reference_baseline.py",
  "architecture_input": "optional participant model.py via --model",
  "reward_input": "generated by the participant UI and applied by the reference PPO rollout",
  "budget_steps": 1000000,
  "n_envs": 4,
  "rollout_length": 64,
  "seed": 17,
  "participant_ownership": {
